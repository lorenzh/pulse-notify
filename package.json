{
  "name": "@lorenzh/pulse-notify",
  "version": "0.0.0",
  "license": "MIT",
  "description": "Sends incident notifications (opened, resolved) to configured channels.",
  "type": "module",
  "private": true,
  "engines": {
    "bun": "1.4.0"
  },
  "scripts": {
    "typecheck": "bun node_modules/typescript7/bin/tsc --noEmit",
    "test": "bun test",
    "lint": "biome check . && pulse-eslint .",
    "format": "biome check --write .",
    "prepare": "lefthook install || true",
    "check": "bun run lint && bun run typecheck && bun run test",
    "start": "bun src/index.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@lorenzh/pulse-config": "github:lorenzh/pulse-config#51e95b0eb463b27a196a33b428607bd92443e4f0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "8.0.2",
    "lefthook": "2.2.2",
    "@types/bun": "1.4.0",
    "typescript7": "npm:typescript@^7.0.2"
  },
  "dependencies": {
    "@lorenzh/pulse-contract": "github:lorenzh/pulse-contract#206bf010c50bc5d19c234f0877aacb9efe1123b8",
    "@lorenzh/pulse-kit": "github:lorenzh/pulse-kit#fa79ba8cd93949fc0cf87f7b41bdaf261dbe4dc6",
    "nodemailer": "10.3.1",
    "zod": "4.6.7"
  },
  "packageManager": "bun@1.4.0"
}
