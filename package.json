{
  "name": "@lorenzh/pulse-notify",
  "version": "0.0.0",
  "license": "MIT",
  "description": "Sends incident notifications (opened, resolved) to configured channels.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-test-coverage --test-coverage-lines=80 --test-coverage-exclude=\"**/*.test.ts\" --test-coverage-exclude=\"test/**\" --test-coverage-exclude=\"**/test/**\" --test-coverage-exclude=\"dist/**\"",
    "lint": "biome check . && pulse-eslint .",
    "format": "biome check --write .",
    "prepare": "lefthook install || true",
    "check": "npm run lint && npm run typecheck && npm run test",
    "start": "node src/index.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@lorenzh/pulse-config": "github:lorenzh/pulse-config#dc7c69698f96e7babebc1e3cddc081d71e5a4201",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "8.0.2",
    "lefthook": "2.2.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@lorenzh/pulse-contract": "github:lorenzh/pulse-contract#e49492764054d05b09e2e76453e7b963d959357b",
    "@lorenzh/pulse-kit": "github:lorenzh/pulse-kit#72adb59b980e2dd4802a1fb8b28eaa5b43b040fc",
    "nodemailer": "10.3.1",
    "zod": "4.6.7"
  }
}
