{
  "name": "@lorenzh/pulse-notify",
  "version": "0.0.0",
  "license": "MIT",
  "description": "Sends incident notifications (opened, resolved) to configured channels.",
  "type": "module",
  "private": true,
  "engines": {
    "bun": "1.4.0"
  },
  "scripts": {
    "typecheck": "bun node_modules/typescript7/bin/tsc --noEmit",
    "test": "bun test",
    "lint": "biome check . && pulse-eslint .",
    "format": "biome check --write .",
    "prepare": "lefthook install || true",
    "check": "bun run lint && bun run typecheck && bun run test",
    "start": "bun src/index.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@lorenzh/pulse-config": "github:lorenzh/pulse-config#dc69a126bebbe50d8a7339ea1325d51b2ea43d7d",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "lefthook": "2.2.2",
    "@types/bun": "1.4.0",
    "typescript7": "npm:typescript@7.0.2"
  },
  "dependencies": {
    "@lorenzh/pulse-contract": "github:lorenzh/pulse-contract#61f7bf88c38ab4827fb47e9409e18d37b9a7ccd3",
    "@lorenzh/pulse-kit": "github:lorenzh/pulse-kit#236df214f9df8658f2992dd6f7c100952c07102b",
    "nodemailer": "10.3.1",
    "zod": "4.6.7"
  },
  "packageManager": "bun@1.4.0"
}
